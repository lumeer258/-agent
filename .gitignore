# ========================================
# 金融新闻行情分析 Agent - Git 忽略规则
# ========================================

# ---- 环境变量文件（包含敏感信息，禁止提交） ----
.env
.env.local
.env.production

# ---- Python 缓存和编译文件 ----
__pycache__/
*.pyc
*.pyo
*.pyd

# ---- 虚拟环境目录 ----
venv/
.venv/
env/

# ---- IDE 和编辑器配置 ----
.vscode/
.idea/
*.swp
*.swo

# ---- 操作系统文件 ----
.DS_Store
Thumbs.db

# ---- 打包和分发 ----
dist/
build/
*.egg-info/

# ---- 数据库文件（运行时生成） ----
*.db
*.sqlite
*.sqlite3

# ---- 日志和数据目录 ----
logs/
data/

# ---- 生成的 PDF 报告 ----
stock_report.pdf
analysis_report.pdf
*_report.pdf

# ---- PID 文件 ----
*.pid
.app.pid

# ---- 临时文件 ----
test_*.py
test_*.db
